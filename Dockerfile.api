FROM alpine:3.23.6@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0 AS upstream

ARG MEM0_COMMIT=94c3fe9f238f3dbf29c9ce98643bd71eb13077cd
ARG MEM0_ARCHIVE_SHA256=0529671008cfa497329439a334d51fd12d24bd664bcdc53f9195c4a10ab63ad7

RUN apk add --no-cache ca-certificates curl tar \
    && curl --fail --location --silent --show-error \
      "https://codeload.github.com/mem0ai/mem0/tar.gz/${MEM0_COMMIT}" \
      --output /tmp/mem0.tar.gz \
    && echo "${MEM0_ARCHIVE_SHA256}  /tmp/mem0.tar.gz" | sha256sum -c - \
    && mkdir /src \
    && tar --extract --gzip --file /tmp/mem0.tar.gz \
      --directory /src --strip-components=1

FROM python:3.12.15-slim-bookworm@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000

WORKDIR /app

COPY --from=upstream /src/server/requirements.txt ./requirements.txt
COPY constraints.txt ./constraints.txt
COPY requirements-runtime.txt ./requirements-runtime.txt
RUN pip install --no-cache-dir \
      --constraint constraints.txt \
      --requirement requirements.txt \
      --requirement requirements-runtime.txt

COPY --from=upstream /src/server/ ./
COPY scripts/ensure-app-db.py scripts/mock-openai.py scripts/start-api.sh ./scripts/
RUN chmod 0555 ./scripts/ensure-app-db.py ./scripts/mock-openai.py ./scripts/start-api.sh \
    && mkdir -p /app/history

EXPOSE 8000

CMD ["./scripts/start-api.sh"]
