FROM alpine:3.23.6@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0 AS upstream

ARG MEM0_COMMIT=94c3fe9f238f3dbf29c9ce98643bd71eb13077cd
ARG MEM0_ARCHIVE_SHA256=0529671008cfa497329439a334d51fd12d24bd664bcdc53f9195c4a10ab63ad7

RUN apk add --no-cache ca-certificates curl tar \
    && curl --fail --location --silent --show-error \
      "https://codeload.github.com/mem0ai/mem0/tar.gz/${MEM0_COMMIT}" \
      --output /tmp/mem0.tar.gz \
    && echo "${MEM0_ARCHIVE_SHA256}  /tmp/mem0.tar.gz" | sha256sum -c - \
    && mkdir /src \
    && tar --extract --gzip --file /tmp/mem0.tar.gz \
      --directory /src --strip-components=1

FROM node:22.23.3-alpine3.23@sha256:baf676f7d0e552f3231945c2f979055ca121bce128c152f7a34e6bd1728b1c5a AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

FROM base AS deps
COPY --from=upstream /src/server/dashboard/package.json /src/server/dashboard/pnpm-lock.yaml /src/server/dashboard/pnpm-workspace.yaml ./
RUN corepack enable \
    && corepack prepare pnpm@10.34.2 --activate \
    && pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=upstream /src/server/dashboard/ ./
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_INSTANCE_NAME=NEXT_PUBLIC_INSTANCE_NAME
RUN corepack enable \
    && corepack prepare pnpm@10.34.2 --activate \
    && pnpm build

FROM base AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=upstream --chown=nextjs:nodejs /src/server/dashboard/entrypoint.sh /home/nextjs/entrypoint.sh
RUN chmod 0555 /home/nextjs/entrypoint.sh

USER nextjs
EXPOSE 3000
ENTRYPOINT ["/home/nextjs/entrypoint.sh"]
CMD ["node", "server.js"]
