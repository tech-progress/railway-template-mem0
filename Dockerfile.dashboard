FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS upstream

ARG MEM0_COMMIT=5a2201d76ba2adba7129e53bfeb81634fc8a6ed4
ARG MEM0_ARCHIVE_SHA256=b781700cfa3bd4a4f7cb611d6b9c3d8625b64ee8747274ba5e0b546e88af6c60

RUN apk add --no-cache ca-certificates curl tar \
    && curl --fail --location --silent --show-error \
      "https://codeload.github.com/mem0ai/mem0/tar.gz/${MEM0_COMMIT}" \
      --output /tmp/mem0.tar.gz \
    && echo "${MEM0_ARCHIVE_SHA256}  /tmp/mem0.tar.gz" | sha256sum -c - \
    && mkdir /src \
    && tar --extract --gzip --file /tmp/mem0.tar.gz \
      --directory /src --strip-components=1

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

FROM base AS deps
COPY --from=upstream /src/server/dashboard/package.json /src/server/dashboard/pnpm-lock.yaml ./
RUN corepack enable \
    && corepack prepare pnpm@10.15.1 --activate \
    && pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=upstream /src/server/dashboard/ ./
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_INSTANCE_NAME=NEXT_PUBLIC_INSTANCE_NAME
RUN corepack enable \
    && corepack prepare pnpm@10.15.1 --activate \
    && pnpm build

FROM base AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=upstream --chown=nextjs:nodejs /src/server/dashboard/entrypoint.sh /home/nextjs/entrypoint.sh
RUN chmod 0555 /home/nextjs/entrypoint.sh

USER nextjs
EXPOSE 3000
ENTRYPOINT ["/home/nextjs/entrypoint.sh"]
CMD ["node", "server.js"]
